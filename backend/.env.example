# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# Placeholder for now — a real Supabase connection string lands when we reach M0-B4.
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/placeholder

# Comma-separated list of origins allowed to call this API from a browser.
# Defaults to the Next.js dev server if unset; add the Vercel URL once deployed.
CORS_ORIGINS=http://localhost:3000

# The single shared password protecting the whole app. Pick anything for
# local dev; on Fly this is set via `flyctl secrets set`, never committed.
APP_ACCESS_PASSWORD=changeme

# Signs the session cookie and encrypts stored API keys. Generate a real one
# with `openssl rand -hex 32`; on Fly this is set via `flyctl secrets set`.
APP_SECRET_KEY=changeme

# Authenticates inbound Yutori webhooks. Yutori doesn't sign its payloads, so
# this token goes in the webhook URL we register with them and is compared on
# every delivery. Unset means the webhook rejects everything (fails closed).
YUTORI_WEBHOOK_SECRET=changeme

# This backend's public HTTPS origin, used to build the webhook URL handed to
# Yutori. Must be externally reachable — localhost can't receive callbacks.
PUBLIC_BASE_URL=https://backend-soft-headland-5023.fly.dev
