# Copy this file to .env.local and fill in real values. .env* is gitignored — never commit it.

# Server-only (no NEXT_PUBLIC_ prefix — never sent to the browser). Next.js
# proxies /api/* to this URL (see next.config.ts) so the browser only ever
# talks to its own origin, keeping the session cookie same-site. For local
# dev this is the backend running on your machine; in Vercel this is the
# deployed Fly.io URL.
BACKEND_URL=http://localhost:8000
